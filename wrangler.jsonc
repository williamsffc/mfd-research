// Cloudflare Workers config. The site is static (dist/); the deploy command in the Cloudflare
// dashboard (README.md → Deployment) passes the same directory and compatibility date.
{
  "name": "mfd-research",
  "compatibility_date": "2026-04-24",
  // A small Worker in front of the pages: requests sent with `Accept: text/markdown` get the
  // page's Markdown copy (Markdown for agents). See worker/index.js.
  "main": "worker/index.js",
  // The Worker reads the site-wide headers from public/_headers.
  "rules": [{ "type": "Text", "globs": ["**/_headers"], "fallthrough": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A missing URL gets dist/404.html with a real 404 status. Without it Cloudflare answers
    // with an empty 404, which browsers show as a broken page.
    "not_found_handling": "404-page",
    // Only the pages go through the Worker; every other file is served directly.
    "run_worker_first": ["/", "/privacy-policy", "/privacy-policy/", "/terms-of-service", "/terms-of-service/"]
  }
}
