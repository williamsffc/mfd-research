---
// Homepage: layout + SEO head; sections live in `src/components/`.
// Styles/behavior are bundled from `src/styles/global.css` and `src/scripts/main.js`;
// static assets and SEO/PWA files live in `public/`.
import { Fragment } from 'astro/jsx-runtime';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import Hero from '../components/Hero.astro';
import CredibilityBar from '../components/CredibilityBar.astro';
import WhoWeHelp from '../components/WhoWeHelp.astro';
import Services from '../components/Services.astro';
import EngagementProcess from '../components/EngagementProcess.astro';
import FounderExpertise from '../components/FounderExpertise.astro';
import TherapeuticExpertise from '../components/TherapeuticExpertise.astro';
import Credentials from '../components/Credentials.astro';
import Conferences from '../components/Conferences.astro';
import WhyMFD from '../components/WhyMFD.astro';
import Faq from '../components/Faq.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { siteDescription } from '../data/company';
import { faqs } from '../data/faqs';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
if (!web3formsAccessKey) {
  console.warn('[mfd-research] PUBLIC_WEB3FORMS_ACCESS_KEY is not set; the contact form will not send.');
}

const title = 'MFD Research';
const ogTitle = 'MFD Research | Where Expertise Meets Execution';
const description = siteDescription;
const canonical = 'https://mfdresearch.com/';

// JSON-LD is generated from the same data the page renders so the FAQ markup can't drift
// from the visible accordion (a Google rich-results requirement).
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://mfdresearch.com/#organization',
      name: 'MFD Research',
      legalName: 'MFD Research Group LLC',
      url: 'https://mfdresearch.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://mfdresearch.com/assets/logo-v2.png',
      },
      description,
      email: 'info@mfdresearch.com',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'US',
        addressRegion: 'CA',
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        email: 'info@mfdresearch.com',
        availableLanguage: 'English',
      },
      founder: {
        '@type': 'Person',
        name: 'Michael Delgado',
        honorificSuffix: 'CCRC',
        jobTitle: 'Founder & Principal',
        sameAs: ['https://www.linkedin.com/in/mike-delgado/'],
      },
      sameAs: ['https://www.linkedin.com/in/mike-delgado/'],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://mfdresearch.com/#faq',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={description}
  ogImage="/assets/og-image-v2.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <PageLoader />

  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <CredibilityBar />
    <WhoWeHelp />
    <Services />
    <EngagementProcess />
    <FounderExpertise />
    <TherapeuticExpertise />
    <Credentials />

    <section id="conferences">
      <Conferences />
    </section>

    <WhyMFD />
    <Faq />
    <ContactCTA web3formsAccessKey={web3formsAccessKey} />
  </main>

  <Footer />

  <button id="backToTop" class="back-to-top" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" aria-hidden="true" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

</BaseLayout>
