---
// Homepage: layout + SEO head; sections live in `src/components/`.
// Styles/behavior are bundled from `src/styles/global.css` and `src/scripts/main.js`;
// static assets and SEO/PWA files live in `public/`.
import { Fragment } from 'astro/jsx-runtime';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import Hero from '../components/Hero.astro';
import CredibilityBar from '../components/CredibilityBar.astro';
import WhoWeHelp from '../components/WhoWeHelp.astro';
import Services from '../components/Services.astro';
import EngagementProcess from '../components/EngagementProcess.astro';
import FounderExpertise from '../components/FounderExpertise.astro';
import TherapeuticExpertise from '../components/TherapeuticExpertise.astro';
import Credentials from '../components/Credentials.astro';
import Conferences from '../components/Conferences.astro';
import WhyMFD from '../components/WhyMFD.astro';
import Faq from '../components/Faq.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { credentials, experience, faq, services, site, specialties } from '../data/content';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
if (!web3formsAccessKey) {
  console.warn('[mfd-research] PUBLIC_WEB3FORMS_ACCESS_KEY is not set; the contact form will not send.');
}

const title = site.title;
const ogTitle = site.shareTitle;
const description = site.description;
const canonical = 'https://mfdresearch.com/';

// JSON-LD (schema.org) for search engines and AI assistants, generated from the same
// content the page renders so it can't drift from what visitors see (the FAQ markup must
// match the visible accordion for Google rich results). Entities link by @id.
const ORIGIN = 'https://mfdresearch.com';
const orgId = `${ORIGIN}/#organization`;
const founderId = `${ORIGIN}/#founder`;
const mfdRole = experience.roles.find((role) => role.organization === 'MFD Research');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${ORIGIN}/#website`,
      url: `${ORIGIN}/`,
      name: 'MFD Research',
      description,
      inLanguage: 'en-US',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'MFD Research',
      alternateName: 'MFDresearch',
      legalName: 'MFD Research Group LLC',
      url: `${ORIGIN}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${ORIGIN}/assets/logo-v2.png`,
      },
      description,
      ...(mfdRole ? { foundingDate: String(mfdRole.startYear) } : {}),
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'US',
        addressRegion: 'CA',
      },
      areaServed: { '@type': 'Country', name: 'United States' },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'Customer Service',
        email: site.email,
        url: site.bookingUrl,
        availableLanguage: 'English',
      },
      founder: { '@id': founderId },
      knowsAbout: [
        ...services.items.map((item) => item.title),
        ...specialties.groups.map((group) => `${group.name} clinical trials`),
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: services.title,
        itemListElement: services.items.map((item) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: item.title,
            description: item.description,
            provider: { '@id': orgId },
            areaServed: { '@type': 'Country', name: 'United States' },
          },
        })),
      },
      sameAs: [site.linkedinUrl],
    },
    {
      '@type': 'Person',
      '@id': founderId,
      name: 'Michael Delgado',
      honorificSuffix: 'CCRC',
      jobTitle: 'Founder & Principal',
      worksFor: { '@id': orgId },
      knowsAbout: specialties.groups.map((group) => group.name),
      hasCredential: credentials.columns.flatMap((column) =>
        column.items.map((item) => ({
          '@type': 'EducationalOccupationalCredential',
          name: item.description,
          dateCreated: String(item.year),
        })),
      ),
      sameAs: [site.linkedinUrl],
    },
    {
      '@type': 'FAQPage',
      '@id': `${ORIGIN}/#faq`,
      mainEntity: faq.questions.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  markdown="/index.md"
  ogTitle={ogTitle}
  ogDescription={description}
  ogImage="/assets/og-image-v2.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <PageLoader />

  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <CredibilityBar />
    <WhoWeHelp />
    <Services />
    <EngagementProcess />
    <FounderExpertise />
    <TherapeuticExpertise />
    <Credentials />

    <section id="conferences">
      <Conferences />
    </section>

    <WhyMFD />
    <Faq />
    <ContactCTA web3formsAccessKey={web3formsAccessKey} />
  </main>

  <Footer />

  <button id="backToTop" class="back-to-top" aria-label="Back to top">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" aria-hidden="true" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
  </button>

</BaseLayout>
