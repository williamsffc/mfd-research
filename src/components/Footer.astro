---
import Button from './Button.astro';
import Logo from './Logo.astro';
---

<!--
  Site footer. Keep id="footerYear" (src/scripts/main.js sets the year) and the bare
  <footer> tag (scripts/test-a11y.mjs checks for it). Styles: "COMPONENT: FOOTER" in
  src/styles/global.css — stacked on phones, three columns from 900px.
-->
<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-brand-link">
          <Logo />
        </a>
        <p class="footer-tagline">Founder-led clinical research operations consulting.</p>
        <a href="https://www.linkedin.com/in/mike-delgado/" class="footer-social-link" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          LinkedIn
        </a>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div>
          <p class="footer-col-title">Company</p>
          <ul class="footer-col-links">
            <li><a href="/#about">About</a></li>
            <li><a href="/#experience">Experience</a></li>
            <li><a href="/#credentials">Credentials</a></li>
            <li><a href="/#conferences">Conferences</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-col-title">Consulting</p>
          <ul class="footer-col-links">
            <li><a href="/#services">Services</a></li>
            <li><a href="/#process">Process</a></li>
            <li><a href="/#specialties">Specialties</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/#contact">Contact</a></li>
          </ul>
        </div>
      </nav>

      <div class="footer-contact">
        <p class="footer-col-title">Get in touch</p>
        <a class="footer-email" href="mailto:info@mfdresearch.com">info@mfdresearch.com</a>
        <Button href="https://calendar.app.google/8fQfrSyLumEMRKHQ9" external variant="accent" class="footer-cta">Schedule a consultation</Button>
        <ul class="footer-notes">
          <li>All inquiries confidential</li>
          <li>Response within 1–2 business days</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">© <span id="footerYear">{new Date().getFullYear()}</span> MFD Research Group LLC. All rights reserved.</p>
      <nav class="footer-links" aria-label="Legal">
        <a href="/privacy-policy/">Privacy Policy</a>
        <a href="/terms-of-service/">Terms of Service</a>
      </nav>
    </div>
  </div>
</footer>
