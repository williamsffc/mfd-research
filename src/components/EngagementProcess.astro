---
import { engagementProcess } from '../data/content';
---
<section id="process">
  <div class="section-label reveal">{engagementProcess.label}</div>
  <h2 class="section-title reveal reveal-delay-1">{engagementProcess.title}</h2>
  <p class="section-sub reveal reveal-delay-2">{engagementProcess.intro}</p>
  <div class="process-steps">
    {engagementProcess.steps.map((step, index) => (
      <Fragment>
        {index > 0 && <div class="process-connector" aria-hidden="true"></div>}
        <div class={`process-step reveal reveal-delay-${(index % 3) + 1}`}>
          <div class="process-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
          <div class="process-step-icon" aria-hidden="true">
            <Fragment set:html={step.iconSvg} />
          </div>
          <h3 class="process-step-title">{step.title}</h3>
          <p class="process-step-desc">{step.description}</p>
        </div>
      </Fragment>
    ))}
  </div>
</section>
