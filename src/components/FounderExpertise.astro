---
import { experience } from '../data/content';
---

<section id="experience">
  <div class="section-label reveal">{experience.label}</div>
  <h2 class="section-title reveal reveal-delay-1">{experience.title}</h2>
  <p class="section-sub reveal reveal-delay-2">{experience.intro}</p>
  <div class="timeline">
    {experience.roles.map(item => (
      <div class="timeline-item">
        <div class={`timeline-dot ${item.endYear === null ? 'current' : ''}`}></div>
        <div class="timeline-year">{item.startYear}–{item.endYear === null ? 'Present' : item.endYear}</div>
        <div class="timeline-role">{item.title}</div>
        <div class="timeline-org">{item.organization}</div>
        <div class="timeline-desc">{item.summary}</div>
      </div>
    ))}
  </div>
</section>
