---
import { why } from '../data/content';
---
<section id="trust">
  <div class="section-label reveal">{why.label}</div>
  <h2 class="section-title reveal reveal-delay-1">{why.title}</h2>
  <p class="section-sub reveal reveal-delay-2">{why.intro}</p>
  <div class="trust-grid">
    {why.cards.map((card, index) => (
      <div class={`trust-card reveal reveal-delay-${(index % 3) + 1}`}>
        <div class="trust-card-icon" aria-hidden="true">
          <Fragment set:html={card.iconSvg} />
        </div>
        <div class="trust-card-title">{card.title}</div>
        <div class="trust-card-desc">{card.description}</div>
      </div>
    ))}
  </div>
</section>
