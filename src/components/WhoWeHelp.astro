---
import { about } from '../data/content';
---
<section id="about">
  <div class="about-grid">
    <div class="about-text">
      <div class="section-label reveal">{about.label}</div>
      <h2 class="section-title reveal reveal-delay-1">{about.title}</h2>
      {about.paragraphs.map((paragraph, index) => (
        <p class={`reveal reveal-delay-${index < 2 ? 2 : 3}`}>{paragraph}</p>
      ))}
    </div>
    <div class="about-visual reveal reveal-delay-2">
      <div class="about-quote">"{about.quote}"</div>
      <div class="about-author">— {about.quoteAuthor}</div>
      <div class="about-tags">
        {about.tags.map(tag => (
          <span class="about-tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</section>
