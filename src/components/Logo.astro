---
// MFD Research logo, inline so it follows the theme and palette tokens
// (--logo-ink, --logo-tagline, --logo-bar-1..3 in src/styles/global.css).
// Wordmark: Barlow, "MFD" Bold + "research" Regular (chosen Sept 2026), outlined so
// no font is needed. Tagline: Barlow Italic. Standalone files: public/assets/logo-v2.svg
// (full, framed) and logo-reversed-v2.svg. On the site the square frame is omitted.
export interface Props {
  /** Show the "Taking research to the next level" tagline (hide it at small sizes). */
  tagline?: boolean;
  class?: string;
}
const { tagline = false, class: className = '' } = Astro.props;
const viewBox = tagline ? '14 92 158 45' : '14 94 157 42';
// The artwork stacks the wordmark over the tagline, both beside the bars. Without the
// tagline, centre the wordmark vertically on the bars (bars centre 115.25).
const wordmarkShift = tagline ? undefined : 'translate(0 6.81)';
---

