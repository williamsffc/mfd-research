---
import { faq } from '../data/content';
---

<section id="faq">
  <div class="section-label reveal">{faq.label}</div>
  <h2 class="section-title reveal reveal-delay-1">{faq.title}</h2>
  <p class="section-sub reveal reveal-delay-2">{faq.intro}</p>
  <div class="faq-list reveal reveal-delay-2">
    {faq.questions.map((item, index) => {
      const answerId = `faq-${index + 1}`;
      return (
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false" aria-controls={answerId}>
            {item.question}
            <span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-answer" id={answerId} hidden>
            <p>{item.answer}</p>
          </div>
        </div>
      );
    })}
  </div>
</section>
