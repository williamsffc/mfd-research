---
// The site's one button style (styles: "COMPONENT: BUTTONS" in src/styles/global.css).
// 8px corners; on the main actions the arrow sits in its own segment.
//   solid    primary action (navy; green in dark mode)
//   outline  secondary action, arrow inline
//   accent   green button on the dark footer
//   on-dark  green outline on the navy sections
// Renders an <a> when `href` is set, otherwise a <button>.
export interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'solid' | 'outline' | 'accent' | 'on-dark';
  size?: 'md' | 'sm';
  /** Where the arrow goes: after the label, before it (pointing back), or none. */
  arrow?: 'end' | 'start' | 'none';
  /** Open in a new tab. */
  external?: boolean;
  class?: string;
}
const {
  href,
  type = 'button',
  variant = 'solid',
  size = 'md',
  arrow = 'end',
  external = false,
  class: className = '',
} = Astro.props;

const classes = ['btn', `btn-${variant}`, size === 'sm' && 'btn-sm', className].filter(Boolean).join(' ');
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const Tag = href ? 'a' : 'button';
const tagAttrs = href ? { href, ...linkAttrs } : { type };
---

<Tag class={classes} {...tagAttrs}>
  {arrow === 'start' && (
    <span class="btn-arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H4M7.5 4.5 4 8l3.5 3.5" /></svg>
    </span>
  )}
  <span class="btn-label"><slot /></span>
  {arrow === 'end' && (
    <span class="btn-arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" /></svg>
    </span>
  )}
</Tag>
